  #rec4147541201 .tn-elem[data-elem-id="1790229583064"] {
    left: 40px !important;
    top: 385px !important;
    width: calc(50% - 60px) !important;
    max-width: 440px !important;
    height: 54px !important;
    display: block !important;
    z-index: 10 !important;
  }
  /* Right column: Artwork on wooden shelf (starts at calc(50% + 20px), width: calc(50% - 60px), height: 340px) */
  #rec4147541201 .tn-elem[data-elem-id="1790160087853000017"] {
    left: calc(50% + 20px) !important;
    right: auto !important;
    top: 40px !important;
    width: calc(50% - 60px) !important;
    max-width: 440px !important;
    height: 340px !important;
    display: block !important;
    z-index: 2 !important;
  }
  #rec4147541201 .tn-elem[data-elem-id="1790160087853000017"] .tn-atom,
  #rec4147541201 .tn-elem[data-elem-id="1790160087853000017"] img {
    width: 100% !important;
    height: 100% !important;
    object-fit: contain !important;
  }
}

/* ========================================================
   9. MOBILE RESPONSIVE ENGINE (< 768px)
   ======================================================== */
@media screen and (max-width: 767px) {
  /* Header: Hide horizontal links row, show Burger */
  .site-header__nav-group {
    display: none !important;
  }
  .site-header__burger {
    display: flex !important;
  }
  .site-header__container {
    height: 62px;
    padding: 0 16px;
    width: 100% !important;
    max-width: 100% !important;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
  }
  .site-header__logo img {
    height: 40px;
  }

  /* Block 1: Hero on Mobile (#rec4137912101) — Clean Vertical Stack */
  #rec4137912101 .t396__artboard {
    height: 480px !important;
    max-width: 100vw !important;
  }
  #rec4137912101 .tn-elem[data-elem-id="1790587786169"] {
    display: none !important;
  }
  #rec4137912101 .tn-elem[data-elem-id="1790143155499000004"] {
    left: 16px !important;
    right: 16px !important;
    top: 30px !important;
    width: calc(100% - 32px) !important;
    text-align: center !important;
    display: block !important;
  }
  #rec4137912101 .tn-elem[data-elem-id="1790143155499000004"] .tn-atom {
    font-size: 34px !important;
    line-height: 1.15 !important;
    color: #2e4744 !important;
    white-space: normal !important;
    text-align: center !important;
  }
  #rec4137912101 .tn-elem[data-elem-id="1790143117283000002"] {
    left: 50% !important;
    transform: translateX(-50%) !important;
    top: 140px !important;
    width: 320px !important;
    max-width: 90vw !important;
    height: auto !important;
    display: block !important;
  }
  #rec4137912101 .tn-elem[data-elem-id="1790143117283000002"] img {
    width: 100% !important;
    height: auto !important;
    object-fit: contain !important;
  }

  /* Block 2: About Me on Mobile (#rec4137897201) */
  #rec4137897201 .t396__artboard {
    min-height: 780px !important;
    height: auto !important;
  }
  #rec4137897201 .tn-elem[data-elem-id="1790145655559000005"] {
    background-color: #eee6de !important;
  }
  #rec4137897201 .tn-elem[data-elem-id="1790145655559000005"] .tn-atom {
    background-color: #eee6de !important;
  }

  /* Footer on mobile: clean vertical stack, still beige */
  .site-footer {
    padding: 24px 16px !important;
  }
  .site-footer__container {
    flex-direction: column !important;
    text-align: center !important;
    gap: 14px !important;
  }
  .site-footer__disclaimer {
    font-size: 13px !important;
    padding: 0 !important;
  }
  .site-footer__copyright {
    font-size: 13px !important;
  }
  .site-footer__totop {
    font-size: 13px !important;
  }

  /* Catalog grid on mobile */
  .t776__parent {
    padding: 0 16px !important;
  }
  .t776__col {
    margin-bottom: 24px !important;
    float: none !important;
    display: block !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  /* Selection block height fix on mobile so button is fully visible */
  #rec4145555601 .t396__artboard {
    min-height: 740px !important;
    height: auto !important;
  }

  /* Zero block header hide */
  #rec4148894601 {
    display: none !important;
  }
}
