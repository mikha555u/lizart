@media screen and (min-width: 1025px) {
  #rec4137912101 .t396__artboard {
    height: 665px !important;
  }
  #rec4137912101 .tn-elem[data-elem-id="1790143117283000002"] {
    top: 110px !important;
    left: calc(50% - 600px + 21px) !important;
    width: 666px !important;
