    z-index: 4 !important;
  }
  #rec4137912101 .tn-elem[data-elem-id="1790143117283000002"] img {
    width: 100% !important;
    height: auto !important;
  }
  #rec4137912101 .tn-elem[data-elem-id="1790143155499000004"] {
    top: 191px !important;
    left: calc(50% - 600px + 583px) !important;
    right: auto !important;
    width: auto !important;
    text-align: right !important;
    display: block !important;
    z-index: 2 !important;
  }
  #rec4137912101 .tn-elem[data-elem-id="1790143155499000004"] .tn-atom {
    font-size: 109px !important;
    line-height: 1 !important;
    white-space: nowrap !important;
  }
}

