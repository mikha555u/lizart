/* ========================================================
   LIZART SHOP — Custom Styles & Modern Responsive Layer
   ======================================================== */

/* 1. Global Viewport & Overflow Protection */
html, body {
  overflow-x: hidden !important;
  max-width: 100vw !important;
  width: 100% !important;
  position: relative !important;
  margin: 0;
  padding: 0;
  background-color: #eee6de !important;
  -webkit-font-smoothing: antialiased;
}

.t-records {
  opacity: 1 !important;
  visibility: visible !important;
  overflow-x: hidden !important;
  max-width: 100vw !important;
  width: 100% !important;
  background-color: #eee6de !important;
}

/* 2. Completely Hide Tilda Copy / Watermark */
#tildacopy,
.t-tildalabel,
.t-tildalabel-free,
.t-tildalabel-free__main,
.t-tildalabel-free__links-wr {
  display: none !important;
  opacity: 0 !important;
  visibility: hidden !important;
  height: 0 !important;
  max-height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  pointer-events: none !important;
}

/* 3. Catalog Paintings: Strictly Sharp 90-Degree Corners & Natural Shadows */
.t776__imgwrapper,
.t1002__picture-wrapper,
.t776__bgimg,
.t-bgimg,
.t776__bgimg_first_hover,
.t776__bgimg_second,
.js-product-img,
.t776__content,
.t776__col,
.t776__item,
.t776__textwrapper,
.t776__title,
.t776__descr,
.t776__btn,
.t-btnflex {
  border-radius: 0px !important;
  -webkit-border-radius: 0px !important;
}

.t776__imgwrapper {
  border-radius: 0px !important;
  -webkit-border-radius: 0px !important;
  overflow: hidden !important;
  box-shadow: 0 10px 24px -4px rgba(46, 71, 68, 0.16), 0 4px 10px -2px rgba(46, 71, 68, 0.08) !important;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1) !important;
  background-color: #ffffff !important;
}

.t776__col:hover .t776__imgwrapper,
.t776__col:focus-within .t776__imgwrapper {
  transform: translateY(-5px) !important;
  box-shadow: 0 20px 35px -6px rgba(46, 71, 68, 0.24), 0 8px 16px -3px rgba(46, 71, 68, 0.12) !important;
}

.t776__content {
  padding-top: 6px !important;
}

/* 4. Freeze Hero Painting Movement (Zero Parallax / Wobble) */
#rec4137912101 .tn-elem[data-elem-id="1790143117283000002"],
#rec4137912101 .tn-elem[data-elem-id="1790143117283000002"] .tn-atom,
#rec4137912101 .tn-elem[data-elem-id="1790143117283000002"] img {
  transform: none !important;
  transition: none !important;
  will-change: auto !important;
  animation: none !important;
}

/* Picture inside hero tn-atom */
#rec4137912101 .tn-elem[data-elem-id="1790143117283000002"] picture {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
}

/* 5. Modern Header & Navigation Bar */
.site-header {
  position: sticky;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 99999;
  background-color: rgba(238, 230, 222, 0.96);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(46, 71, 68, 0.1);
  transition: background-color 0.3s ease, box-shadow 0.3s ease;
}

.site-header.is-scrolled {
  box-shadow: 0 4px 20px rgba(46, 71, 68, 0.08);
}

.site-header__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  box-sizing: border-box;
}

/* Desktop & Tablet Navigation */
.site-header__nav-group {
  display: flex;
  align-items: center;
  gap: 20px;
  flex: 1;
}

.site-header__nav-group--left {
  justify-content: flex-start;
}

.site-header__nav-group--right {
  justify-content: flex-end;
}

.site-header__logo {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  text-decoration: none;
}

.site-header__logo img {
  height: 48px;
  width: auto;
  display: block;
  transition: transform 0.2s ease;
}

.site-header__logo:hover img {
  transform: scale(1.02);
}

.site-header__link {
  color: #34393f;
  text-decoration: none;
  font-family: var(--t-text-font, 'Montserrat', Arial, sans-serif);
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 0.02em;
  white-space: nowrap;
  position: relative;
  padding: 6px 0;
  transition: color 0.2s ease;
}

.site-header__link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0%;
  height: 2px;
  background-color: #2e4744;
  transition: width 0.25s ease;
}

.site-header__link:hover {
  color: #2e4744;
}

.site-header__link:hover::after {
  width: 100%;
}

/* Burger Button (Mobile only, < 768px) */
.site-header__burger {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 10px;
  margin-right: -10px;
  z-index: 100001;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 44px;
  height: 44px;
  border-radius: 4px;
}

.site-header__burger span {
  display: block;
  width: 24px;
  height: 2.5px;
  background-color: #2e4744;
  border-radius: 2px;
  transition: transform 0.3s ease, opacity 0.3s ease;
}

.site-header__burger.is-active span:nth-child(1) {
  transform: translateY(7.5px) rotate(45deg);
}

.site-header__burger.is-active span:nth-child(2) {
  opacity: 0;
}

.site-header__burger.is-active span:nth-child(3) {
  transform: translateY(-7.5px) rotate(-45deg);
}

/* Mobile Drawer Overlay */
.mobile-nav-drawer {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 100000;
  background-color: rgba(238, 230, 222, 0.98);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  flex-direction: column;
  justify-content: space-between;
  padding: 90px 30px 40px;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.3s ease, visibility 0.3s ease;
  box-sizing: border-box;
}

.mobile-nav-drawer.is-open {
  display: flex;
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.mobile-nav-drawer__list {
  display: flex;
  flex-direction: column;
  gap: 22px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.mobile-nav-drawer__link {
  font-family: var(--t-headline-font, 'Tinos', serif);
  font-size: 26px;
  font-weight: 600;
  color: #2e4744;
  text-decoration: none;
  display: inline-block;
  transition: transform 0.2s ease, color 0.2s ease;
}

.mobile-nav-drawer__link:hover,
.mobile-nav-drawer__link:active {
  color: #ff8562;
  transform: translateX(6px);
}

.mobile-nav-drawer__bottom {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding-top: 24px;
  border-top: 1px solid rgba(46, 71, 68, 0.12);
}

.mobile-nav-drawer__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  background-color: #2e4744;
  color: #eee6de;
  text-decoration: none;
  padding: 14px 20px;
  border-radius: 0px !important;
  font-family: var(--t-text-font, 'Montserrat', Arial, sans-serif);
  font-size: 15px;
  font-weight: 600;
  text-align: center;
}

/* 6. Clean, Level Beige Footer (#eee6de) */
.site-footer {
  background-color: #eee6de !important; /* Exact site beige */
  border-top: 1px solid rgba(46, 71, 68, 0.14) !important;
  padding: 24px 20px !important;
  font-family: var(--t-text-font, 'Montserrat', Arial, sans-serif) !important;
  color: #2e4744 !important;
  position: relative !important;
  z-index: 10 !important;
  width: 100% !important;
  box-sizing: border-box !important;
}

.site-footer__container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: nowrap;
}

.site-footer__copyright {
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.04em;
  white-space: nowrap;
  flex-shrink: 0;
  color: #2e4744 !important;
}

.site-footer__disclaimer {
  font-size: 14px;
  font-weight: 400;
  color: #2e4744 !important;
  opacity: 0.85;
  text-align: center;
  flex: 1 1 auto;
  padding: 0 16px;
  line-height: 1.5;
}

.site-footer__totop {
  font-size: 14px;
  font-weight: 500;
  color: #2e4744 !important;
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.site-footer__totop:hover {
  opacity: 0.7;
  transform: translateY(-2px);
}

/* ========================================================
   6. GLOBAL FONT & INTERACTION ENHANCEMENTS
   ======================================================== */
/* Block "Обо мне": Title in site headline serif (Tinos), text in Montserrat */
#rec4137897201 .tn-elem[data-elem-id="1790145655560000006"] .tn-atom {
  font-family: var(--t-headline-font, 'Tinos', serif) !important;
}
#rec4137897201 .tn-elem[data-elem-id="1790145655560000007"] .tn-atom {
  font-family: var(--t-text-font, 'Montserrat', Arial, sans-serif) !important;
}

/* All interactive buttons, icons, links fail-safe clickable & pointer */
.tn-elem[data-elem-type="button"],
.tn-elem[data-elem-type="button"] a,
.tn-elem[data-elem-type="button"] .tn-atom,
#rec4145555601 .tn-elem[data-elem-id="1790229115998"],
#rec4145555601 .tn-elem[data-elem-id="1790229115998"] a,
#rec4147541201 .tn-elem[data-elem-id="1790229583064"],
#rec4147541201 .tn-elem[data-elem-id="1790229583064"] a,
#rec4147541201 .tn-elem[data-elem-id="1790334107969"] a,
#rec4147541201 .tn-elem[data-elem-id="1790334108025"] a,
#rec4147541201 .tn-elem[data-elem-id="1790334107997"] a,
#rec4147541201 .tn-elem[data-elem-id="1790160150944000020"] a,
.js-product-link {
  pointer-events: auto !important;
  cursor: pointer !important;
  z-index: 20 !important;
}

/* FAQ accordion header pointer */
.t849__header,
.t849__trigger-button {
  cursor: pointer !important;
  -webkit-tap-highlight-color: rgba(0, 0, 0, 0.05);
}

/* ========================================================
   7. DESKTOP ORIGINAL OVERLAY VERSION (>= 1025px)
